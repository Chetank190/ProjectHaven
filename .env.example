# Copy to .env and fill in values. Never commit .env.

# ── Team default: backend + frontend on Mac; models on GX10 GPU only ──────────
# See learning/gx10_access_and_gpu_guide.md

# Mac .env — point at GX10 models over Tailscale (replace with your unit's IP)
GX10_TAILSCALE_IP=100.81.85.39
FORCE_CPU_SOLVER=1
NIM_ENDPOINT=http://100.81.85.39:8001/v1
NIM_FALLBACK=http://100.81.85.39:8001/v1
ASR_NIM_URL=http://100.81.85.39:9000

# GX10 .env (on the box only) — required for docker compose up nim
# NGC_API_KEY=your_ngc_key_here

# ── All-on-Mac fallback (regex if no GX10 / no NGC key) ───────────────────────
# FORCE_CPU_SOLVER=1
# NIM_ENDPOINT=http://localhost:8001/v1
# NIM_FALLBACK=http://localhost:8001/v1

NGC_API_KEY=your_ngc_key_here

# Optional cloud LLM tier (MacBook dev without local NIM)
# NVIDIA_CLOUD_ENDPOINT=https://integrate.api.nvidia.com/v1
# NVIDIA_CLOUD_MODEL=google/gemma-3n-e4b-it

# Optional Nemotron primary (llama.cpp on GX10 :30000)
# NIM_ENDPOINT=http://localhost:30000/v1
# NIM_FALLBACK=http://localhost:8001/v1

NIM_API_KEY=not-needed

# NeMo Guardrails (optional — disable for faster startup on MacBook dev)
# GUARDRAILS_ENABLED=1    ← enable on GX10 demo day
VITE_KIOSK_HUB=Union Station

# Frontend URL — must match actual Vite port (3001 fixed; 3000 is PrepBuddy on this machine)
CORS_ORIGINS=http://localhost:3001

# JWT secret — CHANGE THIS before any real deployment
JWT_SECRET=haven-matrix-dev-secret-change-in-prod

# ASR NIM (Parakeet-0.6B-CTC on GPU, port 9000)
# docker compose up asr  →  starts Parakeet on GPU :9000
ASR_NIM_URL=http://localhost:9000
# Fallback: NVIDIA cloud ASR (requires NGC_API_KEY; audio leaves device — demo only)
# ASR_CLOUD_URL=https://integrate.api.nvidia.com/v1

# Set FORCE_CPU_SOLVER=0 and run inside RAPIDS container for GPU KNN (optional advanced)
